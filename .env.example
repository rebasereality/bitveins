# Bitveins Environment Configuration

# Server Binding
HOST=127.0.0.1
PORT=3000

# Authentication & Session Secrets
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_PASSWORD=change_this_to_a_random_32_character_string_secret

# Generate interactively after `pnpm build:cli`: pnpm bitveins hash-password
BITVEINS_AUTH_PASSWORD_HASH=

# Optional: Version identifier for auth session validation
BITVEINS_AUTH_VERSION=1

# CORS & WebSocket Allowed Origins (comma-separated if set)
# BITVEINS_ALLOWED_ORIGINS=https://term.example.com

# Database Configuration
# Custom path for SQLite database (defaults to ~/.local/share/bitveins/history.sqlite)
# BITVEINS_DATABASE_PATH=/path/to/custom/history.sqlite
