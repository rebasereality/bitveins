{
  "name": "bitveins",
  "version": "1.6.1",
  "type": "module",
  "private": true,
  "description": "Async-first web terminal for local tmux sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebasereality/bitveins.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "nuxt build && node scripts/copy-node-pty-native.ts && node scripts/build-cli.ts",
    "build:cli": "node scripts/build-cli.ts",
    "build:release": "pnpm build && node scripts/build-release.ts",
    "smoke:release": "node scripts/smoke-release.ts",
    "smoke:install": "node scripts/smoke-native-install.ts",
    "verify:release": "node scripts/verify-release.ts",
    "bitveins": "node .bitveins-build/cli/index.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "pnpm typecheck && pnpm lint && pnpm test:antigravity-plugin && pnpm test:codex-plugin && pnpm test:hermes-plugin && pnpm test:unit",
    "test:antigravity-plugin": "python3 -m unittest -v integrations/antigravity-notifications/test_notifications.py",
    "test:codex-plugin": "python3 -m unittest -v integrations/codex-notifications/test_notifications.py",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:hermes-plugin": "python3 -m unittest -v integrations/hermes-notifications/test_plugin.py",
    "test:coverage": "vitest run --coverage",
    "test:cli:coverage": "vitest run --coverage --config vitest.cli.config.ts",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@adonisjs/hash": "10.1.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@nuxt/ui": "^4.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/integrations": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "crossws": "^0.4.10",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "markdown-it": "^15.0.0",
    "node-pty": "^1.1.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "sharp": "^0.35.3",
    "sigstore": "4.1.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "tar": "7.5.22",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild": "0.28.2",
      "@tiptap/core": "3.30.0",
      "@tiptap/pm": "3.30.0",
      "@tiptap/starter-kit": "3.30.0",
      "brace-expansion": "5.0.9",
      "tar": "7.5.22",
      "shell-quote@<=1.8.4": ">=1.9.0",
      "svgo@>=4.0.0 <4.0.2": ">=4.0.2",
      "fast-uri": "3.1.5",
      "postcss": "8.5.23"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "workbox-precaching": "7.4.1"
  }
}
